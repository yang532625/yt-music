<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ytm_toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="#000000"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ytm_toolbar_logo_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ytm_toolbar_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/wrapped_logo_content_description"
            android:src="@drawable/ytm_logo" />

        <TextView
            android:id="@+id/ytm_toolbar_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/music_wordmark"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ytm_toolbar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ytm_toolbar_bell"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ytm_notifications"
        android:padding="8dp"
        android:src="@drawable/notification" />

    <ImageView
        android:id="@+id/ytm_toolbar_history"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/history"
        android:padding="8dp"
        android:src="@drawable/history"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ytm_toolbar_search"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search"
        android:padding="8dp"
        android:src="@drawable/search"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ytm_toolbar_account"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/ytm_avatar_bg"
        android:clickable="true"
        android:contentDescription="@string/account"
        android:focusable="true"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/account" />
</LinearLayout>
